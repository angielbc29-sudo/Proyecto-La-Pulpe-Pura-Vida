# ============================================
# .gitignore para aplicaciones de escritorio Qt (C++)
# Compatible con Qt Creator, qmake y CMake
# ============================================

# --- Qt Creator ---
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.autosave
*.user
*.user.*
CMakeLists.txt.user*
.qtcreator/
.qtc_clangd/

# --- Build directories ---
build/
build-*/
*-build-*/
Debug/
Release/
out/
bin/
cmake-build-*/

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
install_manifest.txt
compile_commands.json

# --- qmake ---
Makefile
Makefile.*
.qmake.cache
.qmake.stash
*.qmake.stash
.qmake.conf.user
object_script.*

# --- Archivos generados por Qt (moc, uic, rcc) ---
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
*_autogen/
*_plugin_import.cpp
*_qmltyperegistrations.cpp
.rcc/
.moc/
.uic/
.obj/

# --- Archivos de traducción compilados ---
*.qm

# --- Compilados / objetos ---
*.o
*.obj
*.lo
*.slo
*.la
*.lai
*.gch
*.pch

# --- Librerías y ejecutables ---
*.so
*.so.*
*.dll
*.dylib
*.a
*.lib
*.exe
*.out
*.app
*.exp
*.ilk
*.pdb

# --- Instaladores / paquetes ---
*.msi
*.deb
*.rpm
*.dmg
*.AppImage
*.zip
*.tar.gz

# --- Depuración y perfilado ---
*.core
core.*
*.log
*.dSYM/
*.idb
*.res
*.rc.res

# --- Android (si usas Qt for Android) ---
*.apk
*.aab
android-build/
.gradle/

# --- Otros IDEs ---
.vscode/
.idea/
*.suo
*.sdf
*.opensdf
*.vcxproj.user
.vs/
*.sln.docstates
*.kdev4
.kdev4/
*.code-workspace

# --- Sistema operativo ---
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
$RECYCLE.BIN/

# --- Archivos locales / sensibles ---
.env
*.local
config.local.*